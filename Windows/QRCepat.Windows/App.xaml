<Application x:Class="QRCepat.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ThemeMode="System">
 <Application.Resources>
  <Style TargetType="Button"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,8"/></Style>
  <Style TargetType="TextBox"><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="44"/></Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/>
   <Setter Property="Padding" Value="24"/>
  </Style>
 </Application.Resources>
</Application>
